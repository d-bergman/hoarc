{
  "name": "hoarc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Healing of America Revival Center website",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/serve.mjs",
    "preview": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:rules": "firebase emulators:exec --only database --project demo-hoarc \"node --test tests/database.rules.test.mjs\"",
    "test:integration": "node scripts/run-integration.mjs",
    "check": "npm test && npm run build && node scripts/check.mjs",
    "test:browser": "node scripts/browser-check.mjs",
    "test:cross-browser": "node scripts/cross-browser-check.mjs"
  },
  "dependencies": {
    "bootstrap": "5.3.2",
    "firebase": "12.19.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "esbuild": "0.28.2",
    "firebase-tools": "15.34.1",
    "sharp": "0.35.5",
    "playwright": "1.62.1",
    "@axe-core/playwright": "4.14.0"
  },
  "overrides": { "@grpc/grpc-js": "1.14.6" }
}
